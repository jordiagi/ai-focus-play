# Virtual environments
# NOTE: patterns WITHOUT a trailing slash. A trailing slash matches only a
# directory, so a SYMLINK named .venv slips past it -- which is exactly how a
# worktree convenience symlink once got committed and clobbered the real venv.
backend/.venv
backend/.local
.venv/
.venv
env/
venv/

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Local data and media
backend/.local/
*.mp4
*.mov
*.mkv
*.webm

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent session data
.agents/
.gemini/
.claude/

# scripts/ local overrides and caches
scripts/config.local.env
scripts/.video.sha256

# raw agent transcripts (large, not source of truth - the ledger is)
specs/**/*.log
