# Single source of truth for every script under scripts/.
# Flat KEY=VALUE only - no logic, no conditionals, no command substitution.
# Machine-specific overrides go in scripts/config.local.env (gitignored).
# All paths are RESOLVED (never symlinks) per the repo path rule.

# --- remote host ---------------------------------------------------------
GPU_HOST=root@gpu-box
SSH_OPTS="-o BatchMode=yes -o ControlMaster=auto -o ControlPath=/tmp/aifp-ssh-%r@%h:%p -o ControlPersist=15m -o ServerAliveInterval=30 -o ServerAliveCountMax=6"

# --- remote layout: tmpfs holds derived work, overlay holds caches -------
TMPFS_MOUNT=/workspace
TMPFS_SIZE=64g
REMOTE_ROOT=/workspace/aifp
REMOTE_VIDEO=/workspace/aifp/media/video.mp4
REMOTE_VENV=/workspace/aifp/.venv
REMOTE_OUT=/workspace/aifp/out
REMOTE_LOGS=/workspace/aifp/logs
REMOTE_RUNS=/workspace/aifp/runs
CACHE_ROOT=/opt
REMOTE_PY=3.12

# --- local layout --------------------------------------------------------
REPO_ROOT=/home/ai/workspaces/users/jordi/ai-focus-play
LOCAL_VIDEO=/home/ai/Downloads/arlington-sa-u16b-ecnl-26-27-vs-skyline-u16b-ecnl-2026-09-13-2026-09-13.mp4
LOCAL_ARTIFACTS=/home/ai/workspaces/users/jordi/ai-focus-play/backend/.local/artifacts
GPU_REQS=/home/ai/workspaces/users/jordi/ai-focus-play/scripts/requirements-gpu.txt

# --- torch/CUDA: driver 575.57.08 is CUDA 12.9; cu13 wheels will NOT run -
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# --- good-neighbour GPU budget (Ollama holds mistral+qwen3.8 on this box)-
GPU_MEM_FRACTION=0.30
GPU_ABORT_IF_USED_GB=40

# --- match clock -------------------------------------------------------
# MEASURED 2026-09-19 from Veo's own API, not inferred from match-clock strings.
# video_s = period_time_s + PERIOD<n>_OFFSET_S. Each offset is exact.
# The previous values (561 / 1080 / 2400) were guesses and were wrong for the
# second half by ~217 s -- seven times the old scoring tolerance.
PERIOD1_OFFSET_S=562
PERIOD2_OFFSET_S=3674
KICKOFF_VIDEO_S=562.3
H1_END_VIDEO_S=2879.3
HALFTIME_S=795.1
H2_START_VIDEO_S=3674.4
HALF1_LENGTH_S=2317.0
HALF2_LENGTH_S=2457.7
# Scoring tolerance is now PER TYPE (see scoring_protocol in the benchmark file).
# This is only the fallback for a type not listed there.
SCORE_TOL_DEFAULT_S=3

# --- job defaults --------------------------------------------------------
JOB_SAMPLE_FPS=5
JOB_CHUNK_SEC=120
JOB_IMGSZ_PLAYER=1536
JOB_IMGSZ_BALL=640
JOB_CONF_PLAYER=0.25
JOB_CONF_BALL=0.05
